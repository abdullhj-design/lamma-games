{
  "rules": {
    "content": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'abdullh.ail.1234454@gmail.com'"
    },
    "secrets": {
      ".read": false,
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'abdullh.ail.1234454@gmail.com'"
    },
    "hosts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isString() && (!root.child('secrets/hostPin').exists() || newData.val() == root.child('secrets/hostPin').val())"
      }
    },
    "room": {
      ".read": "auth != null",
      "presence": {
        "$sid": {
          ".write": "auth != null && (!data.exists() || data.child('by').val() == auth.uid) && (!newData.exists() || newData.child('by').val() == auth.uid)",
          ".validate": "newData.hasChildren(['by'])"
        }
      },
      "events": {
        "$topic": {
          ".write": "auth != null && (root.child('hosts/' + auth.uid).exists() || !root.child('secrets/hostPin').exists() || (auth.token.email_verified == true && auth.token.email == 'abdullh.ail.1234454@gmail.com'))"
        }
      }
    },
    "forms": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'abdullh.ail.1234454@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && ((auth.uid == $uid && !data.exists()) || (auth != null && auth.token.email_verified == true && auth.token.email == 'abdullh.ail.1234454@gmail.com'))",
        ".validate": "!newData.exists() || (newData.hasChildren(['name', 't', 'iban', 'bank']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40)",
        "name": {
          ".validate": "newData.isString()"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "iban": {
          ".validate": "newData.isString() && newData.val().matches(/^SA[0-9]{22}$/)"
        },
        "bank": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "qr": {
          ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/')"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}